# Dependencies (this plugin has none at runtime, but a local install may add some)
node_modules/

# Logs and diagnostics
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local packaging output
*.tgz
dist/
coverage/

# Local scratch: anything a contributor drops here to try things out
/tmp/
/scratch/
